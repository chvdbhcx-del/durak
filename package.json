{
  "name": "durak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && vite",
    "wasm": "node scripts/build-wasm.mjs",
    "build": "npm run wasm && tsc -b && vite build",
    "build:single": "npm run wasm && tsc -b && vite build --mode single",
    "preview": "vite preview",
    "test": "npm run wasm && vitest run --exclude \"**/*.sim.test.ts\" --exclude \"e2e/**\" --exclude \"**/node_modules/**\"",
    "test:sim": "npm run wasm && vitest run src/engine/game.sim.test.ts",
    "lint": "eslint src",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-updater": "8.52.1",
    "@fontsource/onest": "5.3.1",
    "@fontsource/unbounded": "5.3.0",
    "framer-motion": "11.11.17",
    "peerjs": "1.5.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
